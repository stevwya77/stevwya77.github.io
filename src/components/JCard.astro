---
/**
 * The outside of the J-card: back flap | spine | front cover.
 * This is the hero. Sizes come from real J-card inches (see tokens.css).
 */
import { site } from '@/data/site';
import CoverArt from './CoverArt.astro';
import Starburst from './deco/Starburst.astro';

const sections = [
  { href: '#side-a', label: 'Side A' },
  { href: '#side-b', label: 'Side B' },
  { href: '#notes', label: 'Notes' },
  { href: '#credits', label: 'Credits' },
];
---

<article class="jcard">
  <nav class="flap" aria-label="Sections">
    <p class="eyebrow flap__head">Index</p>
    <ul class="flap__list">
      {sections.map((s) => (
        <li><a class="eyebrow" href={s.href}>{s.label}</a></li>
      ))}
    </ul>
    <!-- TODO(you) — Step 4: a fake barcode or a tiny recycling mark lives down here. -->
  </nav>

  <div class="spine" aria-hidden="true">
    <span class="spine__cat">{site.catalog}</span>
    <span class="spine__name">{site.name}</span>
    <span class="spine__jp jp">{site.nameJp}</span>
    <span class="spine__cat">{site.year}</span>
  </div>

  <header class="front">
    <div class="front__spec eyebrow">
      <span>Type II · High bias</span>
      <span>C-60</span>
    </div>

    <CoverArt />

    <div class="front__title">
      <h1 class="name">{site.name}</h1>
      <p class="name-jp jp">{site.nameJp}</p>
      <p class="role">
        <span>{site.title}</span>
        <span class="jp">{site.titleJp}</span>
      </p>
    </div>

    <div class="front__foot eyebrow">
      <span>{site.catalog}</span>
      <span>Dolby B NR</span>
      <span>℗ {site.year}</span>
    </div>

    <Starburst />
  </header>
</article>

<style>
  .jcard {
    display: grid;
    grid-template-columns:
      calc(var(--jc-flap) * var(--in))
      calc(var(--jc-spine) * var(--in))
      calc(var(--jc-front) * var(--in));
    height: calc(var(--jc-height) * var(--in));
    width: max-content;
    margin-inline: auto;
    background: var(--paper);
    box-shadow: var(--shadow-lift);
  }

  /* Fold lines between panels, like the score marks on a real card.
     Physical `left`, not `inline-start`: in the spine's vertical writing
     mode, "inline-start" would mean the top edge. */
  .spine,
  .front {
    border-left: 1px dashed var(--fold);
  }

  /* ── Back flap ─────────────────────────────────────────── */
  .flap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-2);
    color: var(--ink-soft);
  }
  .flap__list {
    display: grid;
    gap: var(--space-2);
  }
  .flap a {
    text-decoration: none;
    color: var(--ink);
  }
  .flap a:hover {
    color: var(--moss);
    text-decoration: underline;
  }

  /* ── Spine: reads top to bottom, katakana stays upright ── */
  .spine {
    writing-mode: vertical-rl;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    white-space: nowrap;
    overflow: hidden;
  }
  .spine__name {
    font-family: var(--font-display);
    font-size: calc(var(--in) * 0.14);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex: 1;
  }
  .spine__jp {
    text-orientation: upright;
    font-size: calc(var(--in) * 0.1);
  }
  .spine__cat {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
  }

  /* ── Front cover ───────────────────────────────────────── */
  .front {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: var(--space-3);
    padding: var(--space-4);
    overflow: hidden;
  }
  .front__spec,
  .front__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--ink-soft);
  }
  .front__title {
    display: grid;
    gap: var(--space-1);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: calc(var(--in) * 0.2);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .name-jp {
    font-size: calc(var(--in) * 0.1);
    color: var(--moss);
  }
  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  /* ── Phones: unfold the card vertically ───────────────── */
  @media (max-width: 40rem) {
    .jcard {
      --in: calc((100vw - 2rem) / 2.5);
      grid-template-columns: 1fr;
      grid-template-areas: 'front' 'spine' 'flap';
      width: 100%;
      height: auto;
    }
    .front {
      grid-area: front;
      aspect-ratio: 2.5 / 4;
      border-left: 0;
    }
    .spine {
      grid-area: spine;
      writing-mode: horizontal-tb;
      padding: var(--space-3) var(--space-4);
      border-left: 0;
      border-top: 1px dashed var(--fold);
    }
    .spine__name {
      font-size: var(--text-sm);
    }
    .spine__jp {
      display: none;
    }
    .flap {
      grid-area: flap;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      padding: var(--space-3) var(--space-4);
      border-block-start: 1px dashed var(--fold);
    }
    .flap__list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
    }
  }
</style>
